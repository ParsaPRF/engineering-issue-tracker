# =============================================================================
# Engineering Issue & Ticket Tracking System - environment example
# Copy to .env and fill in. NEVER commit the real .env file.
#
# One file serves both ways of running the project:
#   * local, no containers  -> `python manage.py runserver` reads these values directly
#   * full stack            -> `docker compose up -d` (docker-compose.yml overrides the
#                              container-internal hostnames and the DB/cache/storage backends)
# =============================================================================

# --- Core ---------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,web,backend
# SPA origins: Vite in development, Nginx in the container stack.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Comma separated, scheme included. Never "*" when credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database -----------------------------------------------------------------
# postgres (production / docker) | sqlite (local development fallback)
# The container stack forces postgres for itself; a local run may use sqlite.
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3
# Used when the stack runs PostgreSQL (and by the CI test job).
POSTGRES_DB=eng_tracker
POSTGRES_USER=eng_tracker
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# True for a local run without Redis (tasks execute inline). The container stack overrides it to
# False because it ships a real broker and worker.
CELERY_TASK_ALWAYS_EAGER=True
CACHE_BACKEND=locmem

# --- Object storage (any S3-compatible service) --------------------------------
# local        -> filesystem under MEDIA_ROOT (default for development)
# s3           -> S3-compatible endpoint: s3mock (shipped in compose), MinIO, SeaweedFS,
#                 Ceph RGW, or real AWS S3. Swap the compose service image or point this URL at your
#                 own endpoint; the application only speaks plain S3.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me
AWS_STORAGE_BUCKET_NAME=eng-tracker-attachments
AWS_S3_ENDPOINT_URL=http://localhost:9090
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=False
# Path-style addressing is what self-hosted S3 implementations expect.
AWS_S3_ADDRESSING_STYLE=path
# The bucket is private: no public URLs and no ACLs are ever used.
AWS_QUERYSTRING_AUTH=False

# --- Attachments --------------------------------------------------------------
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,pdf,txt,csv,json,log,zip,doc,docx,xls,xlsx,ppt,pptx

# --- Business rules -----------------------------------------------------------
TICKET_KEY_MAX_RETRIES=5
COMMENT_EDIT_WINDOW_MINUTES=30
ALLOW_SELF_REGISTRATION=True
LOG_LEVEL=INFO

# --- Docker Compose host ports ------------------------------------------------
NGINX_PORT=8080
S3_PORT_HOST=9090
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379